    "privacy": {
      "title": "Privacybeleid",
      "lastUpdated": "Laatste update: mei 2026",
      "s1t": "1. Wie zijn wij?",
      "s1": "SanoBook is agenda- en facturatiesoftware voor zelfstandige zorgverleners in België. Verwerkingsverantwoordelijke: SanoBook SRL, België.",
      "s2t": "2. Verzamelde gegevens",
      "s2": "Wij verzamelen enkel de gegevens die nodig zijn voor de dienstverlening: naam van de patiënt, e-mailadres, telefoonnummer (voor sms-herinneringen) en afspraakslots. Er worden geen medische gegevens, diagnoses of gezondheidsinformatie opgeslagen.",
      "s3t": "3. Rechtsgrondslag (AVG)",
      "s3": "De verwerking is gebaseerd op het gerechtvaardigd belang van de zorgverlener (art. 6(1)(f) AVG): vermindering van no-shows via sms-herinneringen en administratief beheer van de praktijk.",
      "s4t": "4. Telefoonnummers en sms",
      "s4": "Telefoonnummers van patiënten worden uitsluitend gebruikt om 24u voor de afspraak een herinnering en een annuleringslink te sturen. Ze worden nooit gedeeld met derden voor commerciële doeleinden.",
      "s5t": "5. Hosting en overdrachten",
      "s5": "Alle gegevens worden gehost in de Europese Unie (EU West-regio). Er vinden geen overdrachten naar derde landen plaats zonder passende garanties.",
      "s6t": "6. Bewaartermijn",
      "s6": "Afspraakgegevens worden bewaard zolang het account van de zorgverlener actief is. Bij opzegging worden alle gegevens binnen 30 dagen verwijderd.",
      "s7t": "7. Uw rechten",
      "s7": "Conform de AVG hebt u recht op inzage, rectificatie, wissing (art. 17), overdraagbaarheid en bezwaar. Contact: privacy@sanobook.be",
      "s8t": "8. Contact",
      "s8": "Voor vragen over gegevensbescherming: privacy@sanobook.be"
    }
  },
