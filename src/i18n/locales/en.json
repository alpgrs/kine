    "privacy": {
      "title": "Privacy Policy",
      "lastUpdated": "Last updated: May 2026",
      "s1t": "1. Who are we?",
      "s1": "SanoBook is scheduling and invoicing software for independent healthcare practitioners in Belgium. Data controller: SanoBook SRL, Belgium.",
      "s2t": "2. Data collected",
      "s2": "We collect only the data necessary to operate the service: patient name, email address, phone number (for SMS reminders) and appointment slots. No medical data, diagnosis or health information is stored.",
      "s3t": "3. Legal basis (GDPR)",
      "s3": "Processing is based on the legitimate interest of the practitioner (Art. 6(1)(f) GDPR): reducing no-shows via SMS reminders and administrative management of their practice.",
      "s4t": "4. Phone numbers and SMS",
      "s4": "Patient phone numbers are used exclusively to send an appointment reminder 24h before and a cancellation link. They are never shared with third parties for commercial purposes.",
      "s5t": "5. Hosting and transfers",
      "s5": "All data is hosted in the European Union (EU West region). No transfers to third countries are made without adequate guarantees.",
      "s6t": "6. Retention period",
      "s6": "Appointment data is retained as long as the practitioner account is active. On termination, all data is deleted within 30 days.",
      "s7t": "7. Your rights",
      "s7": "Under GDPR you have the right of access, rectification, erasure (Art. 17), portability and objection. Contact: privacy@sanobook.be",
      "s8t": "8. Contact",
      "s8": "For any data protection queries: privacy@sanobook.be"
    }
  },
